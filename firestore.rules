rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isStaff() {
      return isSignedIn() && userDoc().is_active == true;
    }

    // Public read, admin-only write.
    match /counters/{counterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read + public create (kiosk takes a ticket without login).
    // Update requires an active staff account. Delete juga dibuka publik
    // khusus buat fitur "Reset Antrian" di menu satpam Kiosk (nggak ada
    // login di situ) — create/update tetap terkunci staff/shape-validated
    // seperti biasa, cuma delete yang dilonggarkan.
    match /queues/{queueId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'waiting'
        && request.resource.data.keys().hasAll(
          ['counter', 'queue_number', 'queue_code', 'status', 'date', 'dateKey', 'taken_at']
        );
      allow update: if isStaff();
      allow delete: if true;
    }

    // Internal atomic counters backing queue number generation.
    // No direct client read/write outside of the transaction that also
    // writes the matching /queues doc.
    match /queue_counters/{counterKey} {
      allow read: if true;
      allow write: if true;
    }

    // Antrian job cetak tiket fisik. Dibuat publik oleh kiosk (sama seperti
    // /queues) tanpa login; diproses & ditandai selesai oleh helper Windows
    // yang juga jalan tanpa login (nggak ada akun khusus untuk itu), makanya
    // update/delete di sini publik juga — datanya cuma kode antrian & nama
    // loket, bukan data sensitif.
    match /print_jobs/{jobId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(
          ['status', 'queue_code', 'counter_name', 'date', 'dateKey', 'taken_at']
        );
      allow update, delete: if true;
    }

    // Delete dibuka publik juga buat "Reset Antrian" di menu satpam Kiosk
    // (sama alasannya kayak /queues di atas) — create/update tetap
    // terkunci staff.
    match /calls/{callId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if true;
    }

    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin (Loket) menulis penuh saat sync tahunan setelah ganti lokasi.
    // Display TV juga boleh nulis tanpa login — dia read-only secara
    // desain, TAPI kalau data hari ini kosong (belum/sudah lewat masa
    // sync), dia live-fetch ke myquran.com lalu self-heal nulis balik ke
    // sini biar reload berikutnya nggak perlu hit API lagi. Dibatasi cuma
    // boleh nulis field jadwal yang dikenal (sama pola validasi kayak
    // /print_jobs), bukan sembarang field.
    match /prayer_schedule/{dateKey} {
      allow read: if true;
      allow write: if isAdmin()
        || request.resource.data.keys().hasOnly(
          ['imsak', 'subuh', 'terbit', 'dhuha', 'dzuhur', 'ashar', 'maghrib', 'isya']
        );
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Agenda audio custom admin ("bunyi jam segini, sekali/tiap hari").
    // Dikelola penuh oleh admin lewat Loket. Kiosk (tanpa login) boleh
    // update balik cuma dua field ini — nandain kapan terakhir bunyi
    // (buat dedupe "daily") dan matiin otomatis jadwal "once" setelah
    // sekali diputar, biar nggak keulang taun depan di tanggal yang sama.
    match /audio_schedules/{scheduleId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastPlayedAt', 'isActive']);
    }

    // Pengumuman suara sekali-baca — admin ketik teks di Loket, Kiosk
    // langsung bacain lewat TTS sekali begitu muncul (bukan running text
    // ticker kayak /announcements di atas). Kiosk (tanpa login) cuma
    // boleh update field `played` doang, buat nandain udah dibacain biar
    // nggak keulang.
    match /voice_announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.played == false
        && request.resource.data.keys().hasAll(['text', 'createdAt', 'played']);
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['played']);
      allow delete: if isAdmin();
    }

    // Firebase Auth UID keyed profile: self can read own doc, admin can
    // read/manage everyone. Only admin creates/deletes accounts.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
    }
  }
}
